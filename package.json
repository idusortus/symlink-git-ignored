{
  "name": "symlink-git-ignored",
  "version": "0.1.4",
  "description": "Create symlinks in a git worktree to the gitignored files an LLM coding assistant needs, driven by a committed .llm-files manifest.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idusortus/symlink-git-ignored.git"
  },
  "homepage": "https://github.com/idusortus/symlink-git-ignored#readme",
  "bugs": {
    "url": "https://github.com/idusortus/symlink-git-ignored/issues"
  },
  "author": "idusortus (https://github.com/idusortus)",
  "bin": {
    "symlink-git-ignored": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run typecheck",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "git",
    "worktree",
    "symlink",
    "gitignore",
    "llm",
    "ai",
    "dotfiles",
    "claude",
    "opencode"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
